[Unit]
Description=KVM Platform API + UI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kvm-platform
Environment=PORT=8080
Environment=STATIC_DIR=/opt/kvm-platform/web
Environment=HOSTS_FILE=/opt/kvm-platform/config/hosts.json
ExecStart=/opt/kvm-platform/bin/kvm-api
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
